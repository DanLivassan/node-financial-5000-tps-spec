{
  "name": "financial-5000-tps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "test:all": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx scripts/seed-accounts.ts",
    "start:api": "tsx apps/transaction-api/src/main.ts",
    "start:relay": "tsx apps/outbox-relay/src/main.ts",
    "start:consumer": "tsx apps/event-consumer/src/main.ts",
    "start:reconciliation": "tsx apps/reconciliation-worker/src/main.ts",
    "start:redis-lab": "tsx apps/redis-streams-lab/src/main.ts",
    "reconciliation:import": "tsx scripts/reconciliation/import-bank-statement.ts",
    "reconciliation:run": "tsx scripts/reconciliation/run-reconciliation.ts",
    "balance:audit": "tsx scripts/audit-balances.ts",
    "balance:rebuild": "tsx scripts/rebuild-balances.ts",
    "load:10s": "node scripts/load/autocannon-10s.mjs",
    "load:idempotency": "node scripts/load/idempotency-load.mjs",
    "load:balance-contention": "node scripts/load/balance-contention.mjs",
    "load:report": "node scripts/load/report.mjs",
    "cleanup:transactions": "node scripts/cleanup-transactions.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "redis": "^5.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "autocannon": "^8.0.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
